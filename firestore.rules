rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Function to check if the user is logged in via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Staff Users Collection
    match /staff_users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // 2. Menu Items Collection
    match /menu_items/{itemId} {
      allow read, write: if isAuthenticated();
    }

    // 3. Orders Collection
    match /orders/{orderId} {
      // Ensure only logged-in staff can create or view orders
      allow read, write: if isAuthenticated();
    }

    // 4. Shop Status Collection
    match /shop_status/{dateKey} {
      allow read, write: if isAuthenticated();
    }
    
    // By default, deny access to everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
